@item
@ref{Development - Text editing and Vim,,Text editing and Vim}
@item
@ref{Development - Code intelligence and language servers,,Code intelligence and language servers}
@item
@ref{Development - AI-powered development,,AI-powered development}
@item
@ref{Development - Extensions and other IDE functionality,,Extensions and other IDE functionality}
@end itemize

